# Copy this file to .env (git-ignored) and fill in your key.
# Loaded by Spring Boot via spring.config.import=optional:file:.env[.properties]
# and by podman/docker compose natively.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Google Workspace tools (optional) ---
# Leave GOOGLE_WORKSPACE_ENABLED=false to run without the Gmail and Calendar tools; the app starts
# fine and they simply do not appear in tools/list. Set it to true only with all three values below.
#
# One-time setup:
#   1. Create a Google Cloud project and enable the Gmail API and the Google Calendar API.
#   2. Create an OAuth 2.0 client of type "Web application".
#   3. On the OAuth consent screen, add these scopes:
#        https://www.googleapis.com/auth/gmail.readonly
#        https://www.googleapis.com/auth/gmail.compose
#        https://www.googleapis.com/auth/calendar.events
#   4. PUBLISH the consent screen. Left in "Testing", Google expires refresh tokens after 7 days
#      and the tools start failing with an authorisation error every week.
#   5. Run the authorization-code flow once (OAuth Playground, or any local redirect) with
#      access_type=offline and prompt=consent, and keep the refresh token it returns.
GOOGLE_WORKSPACE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
